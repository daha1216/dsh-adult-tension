{
 "id": "07",
 "title": "从陌生到亲近，跨越多个场景",
 "focus": "慢热、证据、阶段不是许可、场景切换后不继承",
 "steps": [
  {
   "say": "开一局，日常，我想慢慢认识一个人",
   "expect": {
    "kind": "opening",
    "calls_max": 2,
    "must_call": [
     "new-game"
    ],
    "budget_group": "first_opening:A",
    "group_max": 2,
    "group_must_call": [
     "doctor",
     "new-game"
    ]
   }
  },
  {
   "say": "我先跟离我最近的那个人打个招呼",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "我问对方在这里待了多久",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "我帮对方把手上的活一起干完",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "干完活，我问对方要不要一起去别处坐坐",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "我们换个地方，我找了个安静的角落坐下",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "我跟对方说了一件我很少跟别人说的事",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "快进到第二天晚上",
   "expect": {
    "kind": "fast_forward",
    "calls_max": 2,
    "must_call": [
     "commit-turn"
    ]
   }
  },
  {
   "say": "我去昨天那个地方等对方",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "我笑着说：“我还以为你不会来。”",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "我轻轻碰了一下对方的手",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  },
  {
   "say": "继续",
   "expect": {
    "kind": "turn",
    "calls_max": 1
   }
  }
 ],
 "player_turns": 12
}
